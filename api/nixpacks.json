{
  "name": "finance-ai-assistant-api",
  "version": "1.0.0",
  "build": {
    "apt_packages": ["libglib2.0-0", "libsm6", "libxext6", "libxrender-dev"],
    "python_version": "3.11",
    "install_cmd": "pip install -r requirements.txt"
  },
  "start": {
    "cmd": "uvicorn src.main:app --host 0.0.0.0 --port {PORT}"
  }
}
